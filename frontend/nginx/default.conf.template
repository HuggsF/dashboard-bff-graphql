# Rendered by the nginx image entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# The SPA and the API share one origin, so the browser can read the X-DB-Query-Count header and
# the Resource Timing sizes without CORS.

server {
    listen 5173;
    server_name _;
    root /usr/share/nginx/html;

    # Docker's embedded DNS: re-resolve the backend if its container is recreated.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $backend ${BACKEND_URL};

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # API responses pass through untouched: compression is the backend's job (and what we measure).
    location /api/ {
        proxy_pass $backend;
    }

    location = /graphql {
        proxy_pass $backend;
    }

    location = /health {
        proxy_pass $backend;
    }

    location /assets/ {
        gzip on;
        gzip_types text/css application/javascript image/svg+xml;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        gzip on;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
