# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# true = human readable logs (pino-pretty, dev only)
LOG_PRETTY=false
# Hard deadline for graceful shutdown (SIGTERM/SIGINT)
SHUTDOWN_TIMEOUT_MS=30000

# ── Database (MySQL 8) — required ────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=dashboard_bff
DB_POOL_MIN=2
DB_POOL_MAX=10
# Run pending migrations when the HTTP server starts
DB_MIGRATE_ON_START=false

# ── HTTP ─────────────────────────────────────────────────────
# Comma-separated list of origins allowed by CORS (the React frontend)
CORS_ORIGINS=http://localhost:5173
# Responses smaller than this are not compressed (gzip / brotli)
COMPRESSION_THRESHOLD_BYTES=1024

# ── GraphQL ──────────────────────────────────────────────────
# Apollo Sandbox on GET /graphql + introspection. Default: true, except in production
GRAPHQL_PLAYGROUND=true
# Queries nested deeper than this are rejected before execution
GRAPHQL_MAX_DEPTH=8

# ── Dashboard ────────────────────────────────────────────────
DASHBOARD_PAGE_SIZE=20
DASHBOARD_MAX_PAGE_SIZE=100
# Upper bound of GET /api/compare?runs=N
COMPARE_MAX_RUNS=10

# ── docker-compose host ports (change if they are taken) ─────
MYSQL_HOST_PORT=3306
BACKEND_HOST_PORT=3000
FRONTEND_HOST_PORT=5173
