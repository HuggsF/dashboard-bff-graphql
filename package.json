{
  "name": "dashboard-bff-graphql",
  "version": "1.0.0",
  "description": "Solving API over-fetching structurally: a 9 MB legacy REST dashboard vs a Backend-For-Frontend with SQL projections vs GraphQL with DataLoader.",
  "main": "dist/index.js",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:rollback": "tsx scripts/migrate.ts --rollback",
    "seed": "tsx scripts/seed.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:int": "jest --selectProjects integration",
    "test:e2e": "jest --selectProjects e2e",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ tests/ scripts/ --max-warnings 0",
    "format": "prettier --write --no-error-on-unmatched-pattern \"{src,tests,scripts}/**/*.ts\" \"frontend/src/**/*.{ts,tsx,css}\" \"frontend/*.ts\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"{src,tests,scripts}/**/*.ts\" \"frontend/src/**/*.{ts,tsx,css}\" \"frontend/*.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dataloader": "^2.2.3",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "graphql": "^16.14.0",
    "knex": "^3.1.0",
    "mysql2": "^3.14.0",
    "on-headers": "^1.1.0",
    "pino": "^9.14.0",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@faker-js/faker": "^10.6.0",
    "@testcontainers/mysql": "^12.2.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.0",
    "@types/on-headers": "^1.0.4",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.0.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.0",
    "rimraf": "^5.0.10",
    "supertest": "^7.1.0",
    "testcontainers": "^12.2.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0"
  }
}
